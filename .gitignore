.DS_Store

# Runtime caches
/cache/*.cache
/cache/*.tmp

# Local Docker/MySQL data
/docker-data/

# User-uploaded files
/avatars/*
!/avatars/.gitkeep
!/avatars/65/
!/avatars/small/
/avatars/65/*
!/avatars/65/.gitkeep
/avatars/small/*
!/avatars/small/.gitkeep
/torrents/*
!/torrents/.gitkeep
!/torrents/images/
/torrents/images/*
!/torrents/images/.gitkeep

# Local backup dumps
/include/backup/

# Logs and temporary files
*.log
*.tmp
*.bak
*.swp
